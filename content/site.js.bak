            { src: "https://cdn.myportfolio.com/fdcb86e4-5441-46ef-9692-b5d292f7d37f/2a849c0e-d949-4757-b893-8a6afc9ef81e_rw_1920.jpg?h=f76d4fe6c0a1e2a68ddc5a28827a8542", w: 1920, h: 1080 },
            { src: "https://cdn.myportfolio.com/fdcb86e4-5441-46ef-9692-b5d292f7d37f/f4c84e89-3775-4fca-a33c-d83cea29ff9c_rw_3840.png?h=9ee8b6dcf23a04a9d6b8c5c0460681f6", w: 3840, h: 2880 },
